+// Opt-in touchscreen scrolling and long-press selection for mobile sessions.
+// Keep this independent of any board/input node.
+static struct wl_touch *mobile_touch;
+static struct {
+    GLFWid window_id;
+    int32_t primary;
+    unsigned contacts;
+    double start_x, start_y, last_y;
+    uint32_t start_time;
+    bool moved, scrolling, selecting, pressed, blocked;
+} mobile_gesture;
+
+static void mobile_click(_GLFWwindow *window) {
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_PRESS, _glfw.wl.xkb.states.modifiers);
+    _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, _glfw.wl.xkb.states.modifiers);
+}
+
+static void mobile_touch_down(void *data UNUSED, struct wl_touch *touch UNUSED,
+        uint32_t serial, uint32_t time, struct wl_surface *surface,
+        int32_t id, wl_fixed_t sx, wl_fixed_t sy) {
+    glfw_cancel_momentum_scroll();
+    if (mobile_gesture.contacts++) {
+        mobile_gesture.blocked = true;
+        return;
+    }
+    _GLFWwindow *window = get_window_from_surface(surface);
+    mobile_gesture.window_id = window && surface == window->wl.surface ? window->id : 0;
+    mobile_gesture.primary = id;
+    mobile_gesture.start_x = wl_fixed_to_double(sx);
+    mobile_gesture.start_y = mobile_gesture.last_y = wl_fixed_to_double(sy);
+    mobile_gesture.start_time = time;
+    mobile_gesture.moved = mobile_gesture.scrolling = mobile_gesture.selecting = mobile_gesture.pressed = mobile_gesture.blocked = false;
+    _glfw.wl.serial = _glfw.wl.input_serial = serial;
+    if (mobile_gesture.window_id) {
+        window->wl.cursorPosX = mobile_gesture.start_x;
+        window->wl.cursorPosY = mobile_gesture.start_y;
+        _glfwInputCursorPos(window, window->wl.cursorPosX, window->wl.cursorPosY);
+    }
+}
+
+static void mobile_touch_motion(void *data UNUSED, struct wl_touch *touch UNUSED,
+        uint32_t time, int32_t id, wl_fixed_t sx, wl_fixed_t sy) {
+    if (!mobile_gesture.contacts || mobile_gesture.blocked || id != mobile_gesture.primary) return;
+    _GLFWwindow *window = _glfwWindowForId(mobile_gesture.window_id);
+    if (!window) return;
+    double px = wl_fixed_to_double(sx), py = wl_fixed_to_double(sy);
+    double dx = fabs(px - mobile_gesture.start_x), dy = fabs(py - mobile_gesture.start_y);
+    if (!mobile_gesture.moved && (dx > 8.0 || dy > 8.0)) {
+        mobile_gesture.moved = true;
+        if (time - mobile_gesture.start_time >= 400) {
+            mobile_gesture.selecting = true;
+            window->wl.cursorPosX = mobile_gesture.start_x;
+            window->wl.cursorPosY = mobile_gesture.start_y;
+            _glfwInputCursorPos(window, window->wl.cursorPosX, window->wl.cursorPosY);
+            _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_PRESS, _glfw.wl.xkb.states.modifiers);
+            mobile_gesture.pressed = true;
+        } else {
+            mobile_gesture.scrolling = dy > dx * 1.2;
+        }
+    }
+    if (mobile_gesture.selecting) {
+        window->wl.cursorPosX = px;
+        window->wl.cursorPosY = py;
+        _glfwInputCursorPos(window, window->wl.cursorPosX, window->wl.cursorPosY);
+    } else if (mobile_gesture.scrolling) {
+        GLFWScrollEvent ev = {.keyboard_modifiers = _glfw.wl.xkb.states.modifiers,
+            .offset_type = GLFW_SCROLL_OFFEST_HIGHRES};
+        ev.unscaled.y = py - mobile_gesture.last_y;
+        ev.y_offset = ev.unscaled.y * _glfwWaylandWindowScale(window);
+        glfw_handle_scroll_event_for_momentum(window, &ev, false, true);
+    }
+    mobile_gesture.last_y = py;
+}
+
+static void mobile_touch_up(void *data UNUSED, struct wl_touch *touch UNUSED,
+        uint32_t serial, uint32_t time, int32_t id) {
+    if (!mobile_gesture.contacts) return;
+    _GLFWwindow *window = _glfwWindowForId(mobile_gesture.window_id);
+    if (id == mobile_gesture.primary && window && !mobile_gesture.blocked) {
+        _glfw.wl.serial = _glfw.wl.input_serial = serial;
+        if (mobile_gesture.scrolling) {
+            GLFWScrollEvent ev = {.keyboard_modifiers = _glfw.wl.xkb.states.modifiers,
+                .offset_type = GLFW_SCROLL_OFFEST_HIGHRES};
+            glfw_handle_scroll_event_for_momentum(window, &ev, true, true);
+        } else if (mobile_gesture.selecting) {
+            if (mobile_gesture.pressed)
+                _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, _glfw.wl.xkb.states.modifiers);
+        } else if (!mobile_gesture.moved && time - mobile_gesture.start_time >= 400) {
+            mobile_click(window);
+            mobile_click(window);
+        } else if (!mobile_gesture.moved) {
+            mobile_click(window);
+        }
+        mobile_gesture.window_id = 0;
+    }
+    if (!--mobile_gesture.contacts) memset(&mobile_gesture, 0, sizeof(mobile_gesture));
+}
+
+static void mobile_touch_frame(void *data UNUSED, struct wl_touch *touch UNUSED) {}
+static void mobile_touch_cancel(void *data UNUSED, struct wl_touch *touch UNUSED) {
+    glfw_cancel_momentum_scroll();
+    memset(&mobile_gesture, 0, sizeof(mobile_gesture));
+}
+static void mobile_touch_shape(void *data UNUSED, struct wl_touch *touch UNUSED,
+        int32_t id UNUSED, wl_fixed_t major UNUSED, wl_fixed_t minor UNUSED) {}
+static void mobile_touch_orientation(void *data UNUSED, struct wl_touch *touch UNUSED,
+        int32_t id UNUSED, wl_fixed_t orientation UNUSED) {}
+static const struct wl_touch_listener mobile_touch_listener = {
+    .down = mobile_touch_down, .up = mobile_touch_up,
+    .motion = mobile_touch_motion, .frame = mobile_touch_frame,
+    .cancel = mobile_touch_cancel, .shape = mobile_touch_shape,
+    .orientation = mobile_touch_orientation,
+};
