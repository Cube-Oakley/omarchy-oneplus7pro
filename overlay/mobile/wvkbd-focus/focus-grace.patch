+/* Keep the exclusive zone across the brief gap between text-input clients. */
+#define IM_HIDE_GRACE_MS 120
+
+static int64_t
+monotonic_ms(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) < 0) {
+        die("Failed to read monotonic clock: %d\n", errno);
+    }
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
 
