{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "kitty-direct", "source": "~/.local/share/omarchy-mobile/omarchy.png", "width": 10, "height": 5, "position": "left", "padding": { "right": 2 } },
  "display": { "separator": "  ", "disableLinewrap": false },
  "modules": [
    "title", "separator", "os", "host", "uptime", "packages", "cpu", "kernel",
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Term" },
    { "type": "gpu", "format": "{name}" },
    { "type": "memory", "key": "Mem" },
    "colors"
  ]
}
