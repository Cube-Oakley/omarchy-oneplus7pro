# Slim fragment for the cheetah stub DT. No vendor clocks/PD, so do not
# built-in USB/UFS/DRM/I2C — those probe-hang on the fat vendor tree.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_BOOT_CONFIG=y
CONFIG_BOOT_CONFIG_EMBED=y
CONFIG_BOOT_CONFIG_FORCE=y
CONFIG_BOOT_CONFIG_EMBED_FILE="@PIXEL_ROOT@/mainline/bootconfig"
CONFIG_INITRAMFS_SOURCE="@PIXEL_ROOT@/out/mainline/builtin-root"
CONFIG_INITRAMFS_FORCE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_SAMSUNG_UARTS=4
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_MAGIC_SYSRQ=y
# CONFIG_USB is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_GADGET is not set
# CONFIG_DRM is not set
# CONFIG_DRM_SIMPLEDRM is not set
# CONFIG_FB_SIMPLE is not set
# CONFIG_PHY_EXYNOS5_USBDRD is not set
# CONFIG_I2C is not set
# CONFIG_SCSI_UFS_DWC_TC_PCI is not set
