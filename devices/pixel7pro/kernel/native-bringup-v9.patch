--- /dev/null
+++ b/arch/arm64/kernel/pixel_earlycon.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Cheetah early framebuffer console, based on the verified RAM probe v2.
+ * Development-only: stock GS201 DT, retained ABL DPP0/DECON0, no display driver.
+ * Uses EFI earlycon's temporary-map -> early_initcall permanent-map pattern.
+ * CONFIG_PSTORE_RAM must be disabled: we own its console buffer during this test.
+ */
+#include <linux/console.h>
+#include <linux/font.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/memblock.h>
+#include <linux/serial_core.h>
+#include <linux/sizes.h>
+#include <asm/arch_timer.h>
+#include <asm/early_ioremap.h>
+
+#define PFB_BASE 0xfac00000UL
+#define PFB_W 1440
+#define PFB_H 3120
+#define PFB_BYTES PAGE_ALIGN(PFB_W * PFB_H * 4)
+#define PFB_DMA 0x1c0b0000UL
+#define PFB_DECON 0x1c240000UL
+#define PFB_LOG 0xfd3ff000UL
+#define PFB_LOG_SIZE SZ_128K
+#define PFB_Y 600
+#define PFB_ROWS 60
+#define PFB_COLS 82
+#define PFB_CH 32
+#define PFB_ROW_BYTES (PFB_CH * PFB_W * 4)
+
+static void *pixel_fb, *pixel_log;
+static void __iomem *pixel_decon;
+static bool pixel_active, pixel_draw;
+static unsigned int pixel_x, pixel_y;
+static u64 last_flush;
+void __init pixel_early_stage(void);
+void __init pixel_early_note(const char *s);
+
+static __ref void *pixel_map(phys_addr_t pa, size_t size, void *permanent)
+{
+	if (permanent)
+		return permanent;
+	return early_memremap_prot(pa, size, pgprot_val(pgprot_writecombine(PAGE_KERNEL)));
+}
+
+static __ref void pixel_unmap(void *p, size_t size, void *permanent)
+{
+	if (!permanent && p)
+		early_memunmap(p, size);
+}
+
+static void pixel_save(const char *s, unsigned int n)
+{
+	u32 *log = pixel_map(PFB_LOG, PFB_LOG_SIZE, pixel_log);
+	u32 used;
+
+	if (!log)
+		return;
+	used = READ_ONCE(log[2]);
+	if (used < PFB_LOG_SIZE - 12) {
+		n = min_t(unsigned int, n, PFB_LOG_SIZE - 12 - used);
+		memcpy((u8 *)log + 12 + used, s, n);
+		wmb();
+		WRITE_ONCE(log[1], used + n);
+		WRITE_ONCE(log[2], used + n);
+		wmb();
+	}
+	pixel_unmap(log, PFB_LOG_SIZE, pixel_log);
+}
+
+void __init pixel_early_stage(void)
+{
+	pixel_save("Linux setup_arch: early mappings ready\n",
+		   sizeof("Linux setup_arch: early mappings ready\n") - 1);
+}
+
+void __init pixel_early_note(const char *s)
+{
+	pixel_save(s, strlen(s));
+	pixel_save("\n", 1);
+}
+
+static void __ref pixel_flush(void)
+{
+	void __iomem *regs;
+	u32 trigger;
+	u64 start, freq = read_sysreg(cntfrq_el0);
+
+	if (!pixel_draw)
+		return;
+	/* Cap normal refreshes at ~25 Hz; RAM log still records every message. */
+	start = __arch_counter_get_cntvct();
+	if (start - last_flush < freq / 25)
+		return;
+	regs = pixel_decon ?: early_ioremap(PFB_DECON, PAGE_SIZE);
+	if (!regs)
+		return;
+	trigger = readl(regs + 0x30);
+	wmb();
+	writel(readl(regs + 0x50) | 0x3f, regs + 0x50);
+	writel(readl(regs + 0x20) | 3, regs + 0x20);
+	writel(readl(regs + 0x50) | 0x80100000, regs + 0x50);
+	writel((trigger & ~0x10U) | 1, regs + 0x30);
+	while (readl(regs + 0x50) && __arch_counter_get_cntvct() - start < freq / 10)
+		cpu_relax();
+	writel(trigger, regs + 0x30);
+	last_flush = __arch_counter_get_cntvct();
+	if (!pixel_decon)
+		early_iounmap(regs, PAGE_SIZE);
+}
+
+static void pixel_write(struct console *con, const char *s, unsigned int n)
+{
+	pixel_save(s, n);
+	if (!pixel_draw)
+		return;
+	while (n) {
+		u32 *row;
+		unsigned long offset = (PFB_Y + pixel_y * PFB_CH) * PFB_W * 4;
+		void *permanent = pixel_fb ? pixel_fb + offset : NULL;
+
+		row = pixel_map(PFB_BASE + offset, PFB_ROW_BYTES, permanent);
+		if (!row)
+			return;
+		if (!pixel_x)
+			for (unsigned int i = 0; i < PFB_CH * PFB_W; i++)
+				row[i] = 0xff101010;
+		while (n && pixel_x < PFB_COLS) {
+			unsigned char c = *s++;
+			n--;
+			if (c == '\r')
+				continue;
+			if (c == '\n') {
+				pixel_x = PFB_COLS;
+				break;
+			}
+			if (c == '\t') c = ' ';
+			for (unsigned int gy = 0; gy < 16; gy++) {
+				u8 bits = ((const u8 *)font_vga_8x16.data)[c * 16 + gy];
+				for (unsigned int gx = 0; gx < 8; gx++) {
+					u32 color = bits & (128 >> gx) ? 0xffffffff : 0xff101010;
+					for (unsigned int dy = 0; dy < 2; dy++) {
+						u32 *p = row + (gy * 2 + dy) * PFB_W + 64 + pixel_x * 16 + gx * 2;
+						p[0] = p[1] = color;
+					}
+				}
+			}
+			pixel_x++;
+		}
+		pixel_unmap(row, PFB_ROW_BYTES, permanent);
+		if (pixel_x == PFB_COLS) {
+			pixel_x = 0;
+			pixel_y = (pixel_y + 1) % PFB_ROWS;
+		}
+	}
+	pixel_flush();
+}
+
+static int __init pixel_setup(struct earlycon_device *device, const char *opt)
+{
+	void __iomem *dma, *decon;
+	u32 *log;
+	u32 base, size, ctrl, global, trigger;
+
+	/* Refuse configurations that would have two writers on the same RAM log. */
+	if (IS_ENABLED(CONFIG_PSTORE_RAM))
+		return -EINVAL;
+	memblock_reserve(PFB_BASE, PFB_BYTES);
+	memblock_mark_nomap(PFB_BASE, PFB_BYTES);
+	memblock_reserve(PFB_LOG, SZ_4M);
+	memblock_mark_nomap(PFB_LOG, SZ_4M);
+	log = pixel_map(PFB_LOG, PFB_LOG_SIZE, NULL);
+	if (!log)
+		return -ENOMEM;
+	log[1] = log[2] = 0;
+	log[0] = 0x43474244;
+	wmb();
+	pixel_unmap(log, PFB_LOG_SIZE, NULL);
+	pixel_save("PIXEL LINUX EARLYCON SETUP\n", sizeof("PIXEL LINUX EARLYCON SETUP\n") - 1);
+	dma = early_ioremap(PFB_DMA, PAGE_SIZE);
+	decon = early_ioremap(PFB_DECON, PAGE_SIZE);
+	if (!dma || !decon) {
+		if (dma) early_iounmap(dma, PAGE_SIZE);
+		if (decon) early_iounmap(decon, PAGE_SIZE);
+		return -ENOMEM;
+	}
+	base = readl(dma + 0x40);
+	size = readl(dma + 0x10);
+	ctrl = readl(dma + 8);
+	global = readl(decon + 0x20);
+	trigger = readl(decon + 0x30);
+	pixel_draw = base == PFB_BASE && size == (PFB_H << 16 | PFB_W) &&
+		!(ctrl & 7) && ((ctrl >> 8) & 63) == 0 && !readl(dma + 0x14) &&
+		!(readl(dma + 0x50) & BIT(20)) && (global & BIT(8)) &&
+		(trigger & 0x11) && !(trigger & 0x102);
+	early_iounmap(dma, PAGE_SIZE);
+	early_iounmap(decon, PAGE_SIZE);
+	device->con->write = pixel_write;
+	pixel_active = true;
+	pr_info("Pixel earlycon: fb=%08x size=%08x ctrl=%08x trigger=%08x draw=%d\n",
+		base, size, ctrl, trigger, pixel_draw);
+	return 0;
+}
+EARLYCON_DECLARE(pixelfb, pixel_setup);
+
+static int __init pixel_remap(void)
+{
+	if (!pixel_active)
+		return 0;
+	pixel_fb = ioremap_wc(PFB_BASE, PFB_BYTES);
+	pixel_log = ioremap_wc(PFB_LOG, PFB_LOG_SIZE);
+	pixel_decon = ioremap(PFB_DECON, PAGE_SIZE);
+	if (!pixel_fb || !pixel_log || !pixel_decon)
+		panic("Pixel earlycon permanent mapping failed");
+	pr_info("Pixel earlycon: permanent mappings ready\n");
+	return 0;
+}
+early_initcall(pixel_remap);
--- /dev/null
+++ b/arch/arm64/kernel/pixel_usb.c
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GS201 RAM-boot USB handoff. No persistent DT or partition changes. */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kstrtox.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/printk.h>
+
+static bool pixel_usb_bind;
+static int __init pixel_usb_arg(char *s)
+{
+	return !kstrtobool(s, &pixel_usb_bind);
+}
+__setup("pixel_usb=", pixel_usb_arg);
+
+static struct property pixel_usb_props[] = {
+	{ .name = "compatible", .value = "snps,dwc3", .length = sizeof("snps,dwc3") },
+	{ .name = "maximum-speed", .value = "high-speed", .length = sizeof("high-speed") },
+	{ .name = "snps,dis_u2_susphy_quirk" },
+	{ .name = "snps,dis_u3_susphy_quirk" },
+	{ .name = "snps,dis_enblslpm_quirk" },
+};
+
+static int __init pixel_usb_register(void)
+{
+	static const char * const remove[] = {
+		"clocks", "clock-names", "phys", "phy-names", "usb-psy-name",
+	};
+	struct device_node *np;
+	struct property *p;
+	struct resource res;
+	int ret = -ENODEV;
+
+	if (!pixel_usb_bind || !IS_ENABLED(CONFIG_USB_DWC3))
+		return 0;
+	np = of_find_node_by_path("/usb@11210000/dwc3");
+	if (!np)
+		return -ENODEV;
+	if (of_address_to_resource(np, 0, &res) ||
+	    res.start != 0x11210000 || resource_size(&res) != 0x10000 ||
+	    of_node_check_flag(np, OF_POPULATED))
+		goto out;
+	/* ABL leaves this PHY running. Do not bind incompatible vendor providers. */
+	for (unsigned int i = 0; i < ARRAY_SIZE(remove); i++) {
+		p = of_find_property(np, remove[i], NULL);
+		if (p && of_remove_property(np, p))
+			goto out;
+	}
+	for (unsigned int i = 0; i < ARRAY_SIZE(pixel_usb_props); i++) {
+		ret = of_update_property(np, &pixel_usb_props[i]);
+		if (ret)
+			goto out;
+	}
+	pr_info("Pixel USB: registering DWC3 with inherited PHY, USB2 peripheral\n");
+	ret = of_platform_device_create(np, NULL, NULL) ? 0 : -ENODEV;
+	pr_info("Pixel USB: platform registration result=%d\n", ret);
+out:
+	of_node_put(np);
+	return ret;
+}
+
+static int __init pixel_usb_inspect(void)
+{
+	void __iomem *regs;
+	u32 id;
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return 0;
+	pr_info("Pixel USB: inspecting inherited DWC3 at 11210000\n");
+	regs = ioremap(0x11210000, 0x10000);
+	if (!regs)
+		return -ENOMEM;
+	id = readl(regs + 0xc120);
+	pr_info("Pixel USB: GSNPSID=%08x\n", id);
+	if ((id >> 16) == 0x5533 || (id >> 16) == 0x3331 ||
+	    (id >> 16) == 0x3332) {
+		pr_info("Pixel USB: GCTL=%08x GSTS=%08x GHWPARAMS0=%08x\n",
+			readl(regs + 0xc110), readl(regs + 0xc118),
+			readl(regs + 0xc140));
+		pr_info("Pixel USB: PHYCFG=%08x PIPE=%08x DCTL=%08x DSTS=%08x\n",
+			readl(regs + 0xc200), readl(regs + 0xc2c0),
+			readl(regs + 0xc704), readl(regs + 0xc70c));
+	}
+	iounmap(regs);
+	if ((id >> 16) != 0x3331)
+		return -ENODEV;
+	return pixel_usb_register();
+}
+late_initcall(pixel_usb_inspect);
