+// SPDX-License-Identifier: GPL-2.0-only
+/* Stop inherited ABL AP watchdogs until the GS201 watchdog driver is ported.
+ * Same WTCON read/clear/write/read sequence as this phone's ABL wdt_stop().
+ * This affects only the current RAM boot, not firmware or PMIC settings.
+ */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/printk.h>
+
+static int __init pixel_watchdog_stop(void)
+{
+	static const char * const compat[] = {
+		"google,gs201-cl0-wdt", "google,gs201-cl1-wdt",
+	};
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return 0;
+	for (unsigned int i = 0; i < ARRAY_SIZE(compat); i++) {
+		struct device_node *np;
+		struct resource res;
+		void __iomem *regs;
+		u32 before, after;
+		int ret;
+
+		np = of_find_compatible_node(NULL, NULL, compat[i]);
+		if (!np)
+			return -ENODEV;
+		ret = of_address_to_resource(np, 0, &res);
+		of_node_put(np);
+		if (ret || res.start != 0x10060000 + i * 0x10000 ||
+		    resource_size(&res) != 0x100)
+			return -EINVAL;
+		regs = ioremap(res.start, resource_size(&res));
+		if (!regs)
+			return -ENOMEM;
+		before = readl(regs);
+		/* WTCON enable bit 5, reset-enable bit 0. Preserve all other bits. */
+		writel(before & ~0x21U, regs);
+		after = readl(regs);
+		pr_info("Pixel WDT%u: inherited WTCON=%08x stopped=%08x count=%08x\n",
+			i, before, after, readl(regs + 8));
+		iounmap(regs);
+		if (after & 0x21)
+			return -EIO;
+	}
+	return 0;
+}
+subsys_initcall(pixel_watchdog_stop);
