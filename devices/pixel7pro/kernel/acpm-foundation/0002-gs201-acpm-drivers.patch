diff --git i/drivers/clk/samsung/clk-acpm.c w/drivers/clk/samsung/clk-acpm.c
index 7680bc8c5..dad5a6328 100644
--- i/drivers/clk/samsung/clk-acpm.c
+++ w/drivers/clk/samsung/clk-acpm.c
@@ -40,6 +40,7 @@ struct acpm_clk_driver_data {
 		.name		= cname,		\
 	}
 
+/* GS101 and GS201 share this firmware DVFS clock ID ordering. */
 static const struct acpm_clk_variant gs101_acpm_clks[] = {
 	ACPM_CLK("mif"),
 	ACPM_CLK("int"),
@@ -101,6 +102,8 @@ static int acpm_clk_register(struct device *dev, struct acpm_clk *aclk,
 
 static int acpm_clk_probe(struct platform_device *pdev)
 {
+	const struct acpm_clk_driver_data *data =
+		(const void *)platform_get_device_id(pdev)->driver_data;
 	struct acpm_handle *acpm_handle;
 	struct clk_hw_onecell_data *clk_data;
 	struct clk_hw **hws;
@@ -114,8 +117,8 @@ static int acpm_clk_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(acpm_handle),
