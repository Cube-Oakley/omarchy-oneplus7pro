libcamera: software_isp: take contrast and saturation defaults from tuning

The Adjust algorithm ignored its tuning data, so contrast and saturation
stayed at 1.0 unless an application set them, and most (GNOME Snapshot
among them) do not. Read optional "contrast" and "saturation" values from
the tuning file and use them until a request sets the controls.

---
diff --git i/src/ipa/simple/algorithms/adjust.cpp w/src/ipa/simple/algorithms/adjust.cpp
index 8bf39c4..6434270 100644
--- i/src/ipa/simple/algorithms/adjust.cpp
+++ w/src/ipa/simple/algorithms/adjust.cpp
@@ -24,15 +24,22 @@ constexpr float kDefaultSaturation = 1.0f;
 
 LOG_DEFINE_CATEGORY(IPASoftAdjust)
 
-int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+int Adjust::init(IPAContext &context, const ValueNode &tuningData)
 {
+	/*
+	 * A sensor's tuning may set the contrast and saturation that apps get
+	 * when they do not choose their own, as most do not.
+	 */
+	defaultContrast_ = tuningData["contrast"].get<float>();
+	defaultSaturation_ = tuningData["saturation"].get<float>();
+
 	context.ctrlMap[&controls::Gamma] =
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
 	context.ctrlMap[&controls::Contrast] =
-		ControlInfo(0.0f, 2.0f, kDefaultContrast);
+		ControlInfo(0.0f, 2.0f, defaultContrast_.value_or(kDefaultContrast));
 	if (context.ccmEnabled)
 		context.ctrlMap[&controls::Saturation] =
-			ControlInfo(0.0f, 2.0f, kDefaultSaturation);
+			ControlInfo(0.0f, 2.0f, defaultSaturation_.value_or(kDefaultSaturation));
 	return 0;
 }
 
@@ -40,8 +47,8 @@ int Adjust::configure(IPAContext &context,
 		      [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
 	context.activeState.knobs.gamma = kDefaultGamma;
-	context.activeState.knobs.contrast = std::optional<float>();
-	context.activeState.knobs.saturation = std::optional<float>();
+	context.activeState.knobs.contrast = defaultContrast_;
+	context.activeState.knobs.saturation = defaultSaturation_;
 
 	return 0;
 }
diff --git i/src/ipa/simple/algorithms/adjust.h w/src/ipa/simple/algorithms/adjust.h
index 49c1f26..ce4781d 100644
--- i/src/ipa/simple/algorithms/adjust.h
+++ w/src/ipa/simple/algorithms/adjust.h
@@ -7,6 +7,8 @@
 
 #pragma once
 
+#include <optional>
+
 #include "libcamera/internal/matrix.h"
 
 #include <libipa/interpolator.h>
@@ -43,6 +45,10 @@ public:
 
 private:
 	void applySaturation(Matrix<float, 3, 3> &ccm, float saturation);
+
+	/* Tuning defaults, used until a request sets the control. */
+	std::optional<float> defaultContrast_;
+	std::optional<float> defaultSaturation_;
 };
 
 } /* namespace ipa::soft::algorithms */
