+/*
+ * Highlight headroom. The brightest pixels, all but this share of them, are
+ * kept below kHighlightTarget of the sensor's range by exposing the sensor up
+ * to kMaxHeadroom stops darker than the loop's exposure; the image processor
+ * applies the same stops back as digital gain, with a shoulder that brings the
+ * sensor's full range to white. A bright lamp in a dim room then keeps its
+ * texture instead of clipping.
+ */
+static constexpr double kHighlightShare = 0.005;
+static constexpr double kHighlightTarget = 0.9;
+static constexpr double kMaxHeadroom = 3.0;
+static constexpr double kHeadroomStep = 0.25;
+
 Agc::Agc()
 {
