@@ -139,6 +151,55 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 	return exposure != oldExposure || again != oldAgain;
 }
 
+void Agc::applyHeadroom(const IPAContext &context, IPAFrameContext &frameContext) const
+{
+	/* Take the headroom off the analogue gain first, then the exposure. */
+	const auto &agc = context.activeState.agc;
+	const auto &limits = context.configuration.agc;
+	const double digitalGain = std::exp2(agc.headroom);
+	const double again = std::clamp(agc.again / digitalGain, limits.againMin, limits.againMax);
+	const double exposure = agc.exposure * agc.again / digitalGain / again;
+	frameContext.sensor.exposure =
+		std::clamp(static_cast<int32_t>(std::lround(exposure)), limits.exposureMin,
+			   limits.exposureMax);
+	frameContext.sensor.gain = again;
+}
+
+void Agc::updateHeadroom(IPAContext &context, const SwIspStats::Histogram &histogram,
+			 unsigned int first, unsigned int size)
+{
+	uint64_t total = 0;
+	for (unsigned int i = 0; i < size; i++)
+		total += histogram[first + i];
+	if (!total)
+		return;
+
+	/* Find the bin holding the brightest pixels but kHighlightShare. */
+	const uint64_t allowed = static_cast<uint64_t>(total * kHighlightShare);
+	uint64_t above = 0;
+	unsigned int top = size;
+	while (top > 0 && above + histogram[first + top - 1] <= allowed)
+		above += histogram[first + --top];
+
+	double &headroom = context.activeState.agc.headroom;
+	if (top >= size) {
+		/* They reach the top bin, where the sensor may clip them. */
+		headroom = std::min(kMaxHeadroom, headroom + kHeadroomStep);
+	} else {
+		/* Their level at the loop's exposure, without the headroom. */
+		const double level = static_cast<double>(top) / size * std::exp2(headroom);
+		const double needed = std::clamp(std::log2(level / kHighlightTarget), 0.0,
+						 kMaxHeadroom);
+		headroom += kHeadroomStep * (needed - headroom);
+	}
+}
+
+void Agc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext, DebayerParams *params)
+{
+	params->digitalGain = std::exp2(context.activeState.agc.headroom);
+}
+
 void Agc::process(IPAContext &context,
 		  const uint32_t frame,
 		  IPAFrameContext &frameContext,
@@ -149,6 +210,8 @@ void Agc::process(IPAContext &context,
