@@ -981,10 +981,23 @@ void DebayerCpu::updateGammaTable(const DebayerParams &params)
 {
 	const float gamma = params.gamma;
 	const float contrastExp = params.contrastExp;
+	const float digitalGain = params.digitalGain;
 
 	const float divisor = gammaTable_.size() - 1.0;
 	for (auto [i, value] : utils::enumerate(gammaTable_)) {
 		float normalized = i / divisor;
+		/*
+		 * Digital gain with a shoulder above half of white, as the GPU
+		 * path applies it, though per channel here.
+		 */
+		if (digitalGain > 1.0f) {
+			normalized *= digitalGain;
+			if (normalized > 0.5f) {
+				const float s0 = (digitalGain - 0.5f) / 0.5f;
+				const float t = (normalized - 0.5f) / (digitalGain - 0.5f);
+				normalized = 0.5f + 0.5f * s0 * t / (1.0f + (s0 - 1.0f) * t);
+			}
+		}
 		/* Convert 0..2 to 0..infinity; avoid actual inifinity at tan(pi/2) */
 		/* Apply simple S-curve */
 		if (normalized < 0.5)
