 		context.activeState.agc.stableSamples = 0;
 		context.activeState.agc.validSamples = 0;
 		context.activeState.agc.valid = true;
@@ -167,8 +231,7 @@ void Agc::process(IPAContext &context,
 		 * Use the new exposure and gain values calculated the last time
 		 * there were valid stats.
 		 */
-		frameContext.sensor.exposure = context.activeState.agc.exposure;
-		frameContext.sensor.gain = context.activeState.agc.again;
+		applyHeadroom(context, frameContext);
 		return;
 	}
 
@@ -178,8 +241,7 @@ void Agc::process(IPAContext &context,
 	 * traversed the delayed-control pipeline.
 	 */
 	if (frame % kAgcUpdateInterval) {
-		frameContext.sensor.exposure = context.activeState.agc.exposure;
-		frameContext.sensor.gain = context.activeState.agc.again;
+		applyHeadroom(context, frameContext);
 		return;
 	}
 
@@ -205,8 +267,17 @@ void Agc::process(IPAContext &context,
 		return;
 	}
 
+	/*
+	 * Judge the exposure as it will look after the digital gain: the loop
+	 * aims the displayed image at the target, while the sensor keeps the
+	 * headroom.
+	 */
+	updateHeadroom(context, histogram, blackLevelHistIdx, histogramSize);
+	const double digitalGain = std::exp2(context.activeState.agc.headroom);
 	for (unsigned int i = 0; i < histogramSize; i++) {
-		unsigned int idx = (i - (i / yHistValsPerBinMod)) / yHistValsPerBin;
+		const unsigned int gained = std::min<unsigned int>(
+			histogramSize - 1, static_cast<unsigned int>(std::lround(i * digitalGain)));
+		unsigned int idx = (gained - (gained / yHistValsPerBinMod)) / yHistValsPerBin;
 		exposureBins[idx] += histogram[blackLevelHistIdx + i];
 	}
 
