diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 0b641a5..87a8b6b 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,29 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform float digitalGain;
+
+/*
+ * Digital gain gives back the stops the exposure algorithm took off the sensor
+ * to keep highlights. Above half of white a rational shoulder brings the
+ * sensor's full range to exactly white instead of clipping it, following the
+ * brightest channel so colours keep their hue. At a gain of 1 it does nothing.
+ */
+vec3 apply_digital_gain(vec3 rgb)
+{
+	if (digitalGain <= 1.0)
+		return rgb;
+	float peak = max(rgb.r, max(rgb.g, rgb.b));
+	if (peak <= 0.0)
+		return rgb;
+	float x = peak * digitalGain;
+	if (x > 0.5) {
+		float s0 = (digitalGain - 0.5) / 0.5;
+		float t = (x - 0.5) / (digitalGain - 0.5);
+		x = 0.5 + 0.5 * s0 * t / (1.0 + (s0 - 1.0) * t);
+	}
+	return rgb * (x / peak);
+}
 
 float apply_contrast(float value)
 {
@@ -238,6 +261,8 @@ void main(void)
 	/* Colour Correction Matrix */
 	rgb = ccm * rgb;
 
+	rgb = apply_digital_gain(rgb);
+
 	/*
 	 * Contrast
 	 * contrastExp 0..2 contrast to 0..infinity; avoid actual infinity at tan(pi/2)
