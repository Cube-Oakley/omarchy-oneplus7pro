+static void ath10k_wmi_tlv_key_complete(struct ath10k *ar, struct sk_buff *skb)
+{
+	const struct wmi_tlv_key_complete_ev *ev;
+	const void **tb;
+
+	if (ar->hif.bus != ATH10K_BUS_SNOC)
+		return;
+	tb = ath10k_wmi_tlv_parse_alloc(ar, skb->data, skb->len, GFP_ATOMIC);
+	if (IS_ERR(tb))
+		return;
+	ev = tb[WMI_TLV_TAG_STRUCT_VDEV_INSTALL_KEY_COMPLETE_EVENT];
+	if (!ev)
+		goto out;
+	ath10k_dbg(ar, ATH10K_DBG_WMI,
+		   "key ack vdev %u idx %u flags %u status %u\n",
+		   le32_to_cpu(ev->vdev_id), le32_to_cpu(ev->key_idx),
+		   le32_to_cpu(ev->key_flags), le32_to_cpu(ev->status));
+	spin_lock_bh(&ar->data_lock);
+	if (ar->key_wmi_pending &&
+	    ar->key_wmi_vdev == le32_to_cpu(ev->vdev_id) &&
+	    ar->key_wmi_idx == le32_to_cpu(ev->key_idx) &&
+	    ar->key_wmi_flags == le32_to_cpu(ev->key_flags) &&
+	    ether_addr_equal(ar->key_wmi_addr, ev->peer_macaddr.addr)) {
+		ar->key_wmi_status = le32_to_cpu(ev->status) ? -EIO : 0;
+		ar->key_wmi_pending = false;
+		complete(&ar->key_wmi_done);
+	}
+	spin_unlock_bh(&ar->data_lock);
+out:
+	kfree(tb);
+}
