+
+/*
+ * Keep a command out of a command mode frame's way (msm_drv.h): wait until
+ * no kicked-off frame is pending, and hold new kickoffs off while it is
+ * sent. Commands during panel setup, before the display is bound, and in
+ * video mode (no command mode encoder publishes) pass straight through.
+ */
+int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
+{
+	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
+	struct msm_drm_private *priv = msm_dsi && msm_dsi->dev ? msm_dsi->dev->dev_private : NULL;
+	int ret;
+
+	if (!priv)
+		return dsi_mgr_cmd_xfer(id, msg);
+
+	mutex_lock(&priv->cmd_xfer_lock);
+	if (priv->cmd_frames_wq &&
+	    !wait_event_timeout(*priv->cmd_frames_wq,
+				atomic_read(priv->cmd_pending_frames) == 0,
+				msecs_to_jiffies(50)))
+		DBG("command mode frame still pending, sending anyway");
+	ret = dsi_mgr_cmd_xfer(id, msg);
+	mutex_unlock(&priv->cmd_xfer_lock);
+
+	return ret;
+}
 
