+/*
+ * Stock timing@3: the same pixel clock and DSC stream as 60 Hz, with the
+ * vertical blanking shrunk (1472 x 4704 x 60 == 1472 x 3136 x 90), so the DSI
+ * link rate does not change. Only the control-display byte differs.
+ */
+static const struct drm_display_mode samsung_oneplus_dsc_90hz_mode = {
+	.clock = (1440 + 16 + 8 + 8) * (3120 + 4 + 4 + 8) * 90 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 16,
+	.hsync_end = 1440 + 16 + 8,
+	.htotal = 1440 + 16 + 8 + 8,
+	.vdisplay = 3120,
+	.vsync_start = 3120 + 4,
+	.vsync_end = 3120 + 4 + 4,
+	.vtotal = 3120 + 4 + 4 + 8,
+	.width_mm = 71,
+	.height_mm = 154,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static u8 samsung_oneplus_dsc_control_display(struct samsung_oneplus_dsc *ctx)
+{
+	struct drm_connector *connector = ctx->connector;
+
+	/* 60 Hz is the preferred mode, and the safe answer when none is known. */
+	if (connector && connector->state && connector->state->crtc &&
+	    drm_mode_match(&connector->state->crtc->state->mode,
+			   &samsung_oneplus_dsc_90hz_mode,
+			   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+		return 0x30;
+	return 0x20;
+}
+
 static int samsung_oneplus_dsc_get_modes(struct drm_panel *panel,
 					 struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &samsung_oneplus_dsc_mode);
+	static const struct drm_display_mode * const modes[] = {
+		&samsung_oneplus_dsc_60hz_mode,
+		&samsung_oneplus_dsc_90hz_mode,
+	};
+	struct samsung_oneplus_dsc *ctx = to_samsung_oneplus_dsc(panel);
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	ctx->connector = connector;
+	for (i = 0; i < ARRAY_SIZE(modes); i++) {
+		mode = drm_mode_duplicate(connector->dev, modes[i]);
+		if (!mode)
+			return -ENOMEM;
+		drm_mode_set_name(mode);
+		mode->type |= DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_probed_add(connector, mode);
+	}
+	connector->display_info.width_mm = modes[0]->width_mm;
+	connector->display_info.height_mm = modes[0]->height_mm;
+	return ARRAY_SIZE(modes);
 }
 
